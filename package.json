{
  "name": "@ape.swap/apeswap-lists",
  "version": "5.0.0-test.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApeSwapFinance/apeswap-lists.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "yarn typecheck && yarn legacy-build && rimraf ./lib && tsc --target es2017 --module commonjs && yarn run format:write",
    "start": "tsx watch scripts/build-legacy-config.ts",
    "prepublishOnly": "yarn build",
    "prepare": "husky install",
    "test": "jest",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json}\"",
    "format:check:staged": "pretty-quick --staged --check",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "legacy-build": "tsx scripts/build-legacy-config.ts"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "5.30.7",
    "@typescript-eslint/parser": "5.30.7",
    "eslint": "8.20.0",
    "husky": "6.0.0",
    "jest": "30.5.1",
    "prettier": "2.7.1",
    "pretty-quick": "3.1.3",
    "rimraf": "3.0.2",
    "ts-jest": "29.4.12",
    "tslib": "2.4.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "description": "## How to Manage this Repo",
  "bugs": {
    "url": "https://github.com/ApeSwapFinance/apeswap-lists/issues"
  },
  "homepage": "https://github.com/ApeSwapFinance/apeswap-lists#readme",
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
